{
  "name": "asteroid-map",
  "version": "0.1.0",
  "description": "Interactive educational asteroid impact-effects simulator using NASA/JPL close-approach data.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "homepage": "https://asteroidmap.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZipLyne-Agency/Asteroid-Map.git"
  },
  "bugs": {
    "url": "https://github.com/ZipLyne-Agency/Asteroid-Map/issues"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:physics": "npm test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "lucide-react": "^0.553.0",
    "maplibre-gl": "^5.24.0",
    "next": "^15.5.20",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-map-gl": "^8.1.1",
    "supercluster": "^8.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supercluster": "^7.1.3",
    "eslint": "9.39.1",
    "eslint-config-next": "^16.2.10",
    "postcss": "8.5.23",
    "tailwindcss": "4.1.11",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.23"
  }
}
