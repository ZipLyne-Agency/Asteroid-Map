# Optional: canonical public origin used for metadata, sitemaps, and social cards.
NEXT_PUBLIC_SITE_URL=https://asteroidmap.com

# Optional: identify this deployment to OpenStreetMap Nominatim.
# Use a real monitored contact address for a public deployment.
NOMINATIM_USER_AGENT=AsteroidMap/1.0 (+https://asteroidmap.com; contact@example.com)

# Optional search-engine ownership verification tokens.
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
